# External dataset source configuration (all optional).
# Copy to .env.local and fill in to point the app at a real spreadsheet.
# NONE of these are secrets: only PUBLIC, published URLs belong here. Never put an API key,
# OAuth token or service-account credential in a VITE_* var — they ship to the browser.
# With nothing set, the app uses the bundled demo dataset (public/data/district-datasets.csv).

# Which source to use: "local" | "google-sheets" | "excel" | "postgres".
# If unset, it is inferred: a Google URL below → google-sheets; else an Excel URL → excel; else local.
# VITE_DATASET_SOURCE=google-sheets

# Google Sheets: a PUBLISHED CSV export URL.
#   File → Share → Publish to web → (this sheet) → Comma-separated values (.csv)
#   or a link of the form  https://docs.google.com/spreadsheets/d/<ID>/export?format=csv&gid=<GID>
# A PRIVATE sheet cannot be fetched safely client-side — that needs a server-side provider.
# VITE_GOOGLE_SHEETS_CSV_URL=

# Excel: a public .xlsx URL (or just use the "Load Excel…" button in the app to upload a file).
# VITE_EXCEL_URL=/data/sample-district-data.xlsx
# Worksheet name (required only if the workbook has more than one sheet).
# VITE_EXCEL_SHEET_NAME=DistrictData

# ── PostgreSQL (database phase) ─────────────────────────────────────────────────────────────
# DATABASE_URL is SERVER-SIDE ONLY — it is read by db/*.mts and the API (db/server.mts). It is
# NOT a VITE_ var, so it never ships to the browser. Keep it in .env.local (gitignored). Never
# commit real credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/indias_map
# Backend API port (used by the API server and the Vite /api proxy). Default 8787.
# API_PORT=8787
# To make the FRONTEND read from PostgreSQL (via the API), set:
# VITE_DATASET_SOURCE=postgres
# API base the browser calls (default "/api", proxied to the backend by Vite in dev).
# VITE_API_BASE=/api

# ── Automatic sync (spreadsheet → PostgreSQL) — server-side, see docs/DATABASE.md ───────────
# Which source the sync service reads: "excel" (default), "google", or "word" (DOCX). Inferred
# from the URLs below when unset.
# SYNC_SOURCE=excel
# Server-readable Excel FILE path (defaults from VITE_EXCEL_URL, e.g. public/data/<file>.xlsx).
# SYNC_EXCEL_FILE=public/data/sample_india_district_dataset.xlsx
# Word/DOCX source (run a SEPARATE watcher for it, with its own source id):
#   SYNC_SOURCE=word DATASET_SOURCE_ID=community-radio npm run db:sync:watch
# SYNC_WORD_FILE=public/data/community-radio-stations.docx
# Detailed Community Radio CRS Excel source (authoritative — raw stations + derived count):
#   SYNC_SOURCE=crs DATASET_SOURCE_ID=community-radio-crs npm run db:sync:watch
# SYNC_CRS_FILE=public/data/CRS(data).xlsx
# Google polling interval in ms (default 300000 = 5 min). Excel uses file-watch + this as a safety poll.
# DATASET_SYNC_INTERVAL_MS=300000
# Logical source id (deletions are scoped to it; lets multiple sources coexist safely).
# DATASET_SOURCE_ID=main-dataset
# Frontend version-poll interval in ms for auto-refresh when the DB changes (default 45000, min 5000).
# VITE_DATASET_POLL_MS=45000
